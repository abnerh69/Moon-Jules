# Moon-Jules — variables de entorno.
#
# Copiar a ~/.config/moon-jules/.env (o al directorio desde el que
# ejecutes la CLI) y rellenar. Este archivo SÍ va al repositorio; el
# `.env` con valores NO: está en .gitignore desde el primer commit.
#
#   cp .env.example ~/.config/moon-jules/.env
#   chmod 600 ~/.config/moon-jules/.env
#
# Una variable ya presente en el entorno real gana sobre el `.env`, así
# que puedes sobrescribir para una sola ejecución sin editar nada.

# Credencial de Jules. Se obtiene en https://jules.google.com/settings#api
JULES_API_KEY=

# Solo si usas el database secret (obsoleto). Con cuenta de servicio no
# hace falta: la ruta a la clave va en el config. Ver docs/RTDB.md
MOONJULES_RTDB_TOKEN=

# Token de GitHub, cuando se implemente la cola de issues (épica E06).
# Si usas `gh` autenticado, no hace falta.
GITHUB_TOKEN=
